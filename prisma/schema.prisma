generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Status {
  ACTIVE
  INACTIVE
  UNVERIFIED
}

model Company {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users       User[]
  shift_types ShiftType[]
  skills      Skill[]

  @@map("company")
}

model User {
  id                       Int       @id @default(autoincrement())
  first_name               String?
  last_name                String?
  email                    String    @unique
  password                 String?
  image                    String?
  role                     Role      @default(EMPLOYEE)
  status                   Status    @default(UNVERIFIED)
  company_id               Int?
  email_verification_token String?   @unique
  password_reset_token     String?   @unique
  password_reset_expires   DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  company           Company?              @relation(fields: [company_id], references: [id])
  accounts          Account[]
  assigned_shifts   UserHasShift[]
  skills            UserHasSkill[]
  date_preferences  ShiftDatePreference[]
  unavailable_dates UnavailableDate[]

  @@map("user")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model ShiftType {
  id         Int      @id @default(autoincrement())
  name       String
  start_time DateTime @db.Time
  end_time   DateTime @db.Time
  company_id Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company        @relation(fields: [company_id], references: [id])
  shifts  UserHasShift[]

  @@map("shift_type")
}

model UserHasShift {
  id            Int         @id @default(autoincrement())
  user_id       Int
  shift_type_id Int
  date          DateTime    @db.Date
  status        ShiftStatus @default(SCHEDULED)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  shift_type ShiftType @relation(fields: [shift_type_id], references: [id])

  @@unique([user_id, shift_type_id, date])
  @@map("user_has_shift")
}

enum ShiftStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PreferenceType {
  DESIRED
  UNDESIRED
}

enum LeaveType {
  SICK_LEAVE
  VACATION
  PERSONAL_LEAVE
  UNPAID_LEAVE
  OTHER
}

model Skill {
  id         Int      @id @default(autoincrement())
  name       String
  company_id Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company        @relation(fields: [company_id], references: [id])
  users   UserHasSkill[]

  @@unique([name, company_id])
  @@map("skill")
}

model UserHasSkill {
  id         Int      @id @default(autoincrement())
  user_id    Int
  skill_id   Int
  created_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skill_id], references: [id])

  @@unique([user_id, skill_id])
  @@map("user_has_skill")
}

model ShiftDatePreference {
  id              Int            @id @default(autoincrement())
  user_id         Int
  date            DateTime       @db.Date
  preference_type PreferenceType
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date, preference_type])
  @@index([user_id, date])
  @@map("shift_date_preference")
}

model UnavailableDate {
  id         Int       @id @default(autoincrement())
  user_id    Int
  start_date DateTime  @db.Date
  end_date   DateTime  @db.Date
  leave_type LeaveType
  reason     String?   @db.Text
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, start_date, end_date])
  @@index([user_id, start_date, end_date])
  @@map("unavailable_date")
}
